{
    "meta": {
        "label": "Earth-2: preflight check",
        "description": "Check that a FourCastNet NIM connection is usable: endpoint health, model, Earth2Studio variable list, GPU memory and init time availability.",
        "icon": "icon-check"
    },
    "impersonate": false,
    "permissions": [],
    "resultType": "HTML",
    "resultLabel": "Preflight results",
    "macroRoles": [
        {"type": "PROJECT_MACROS"}
    ],
    "params": [
        {
            "name": "connection",
            "label": "NIM connection",
            "type": "PRESET",
            "parameterSetId": "earth2-nim-connection",
            "mandatory": true
        },
        {
            "name": "source",
            "label": "Data source",
            "type": "SELECT",
            "defaultValue": "era5_arco",
            "selectChoices": [
                {"value": "era5_arco", "label": "ERA5 reanalysis (ARCO)"},
                {"value": "gfs", "label": "NOAA GFS analysis"}
            ]
        },
        {
            "name": "init_time",
            "label": "Init time to check (UTC)",
            "type": "STRING",
            "description": "Optional. Empty reports the latest available cycle"
        }
    ]
}
